{"info":{"name":"Currency Exchange App - Frankfurter","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"baseUrl","value":"https://api.frankfurter.dev/v1"}],"item":[{"name":"Listar moedas","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status 200',()=>pm.response.to.have.status(200));","pm.test('tem USD e BRL',()=>{const j=pm.response.json();pm.expect(j).to.have.property('USD');pm.expect(j).to.have.property('BRL');});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/currencies"}},{"name":"Cotacao mais recente USD-BRL","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status 200',()=>pm.response.to.have.status(200));","pm.test('retorna base, date e rates.BRL',()=>{const j=pm.response.json();pm.expect(j.base).to.eql('USD');pm.expect(j).to.have.property('date');pm.expect(j.rates.BRL).to.be.a('number');});"]}}],"request":{"method":"GET","url":{"raw":"{{baseUrl}}/latest?base=USD&symbols=BRL","host":["{{baseUrl}}"],"path":["latest"],"query":[{"key":"base","value":"USD"},{"key":"symbols","value":"BRL"}]}}},{"name":"Historico por intervalo USD-BRL","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status 200',()=>pm.response.to.have.status(200));","pm.test('rates agrupado por data',()=>{const j=pm.response.json();pm.expect(Object.keys(j.rates).length).to.be.above(0);const first=Object.values(j.rates)[0];pm.expect(first.BRL).to.be.a('number');});"]}}],"request":{"method":"GET","url":{"raw":"{{baseUrl}}/2026-09-01..2026-09-30?base=USD&symbols=BRL","host":["{{baseUrl}}"],"path":["2026-09-01..2026-09-30"],"query":[{"key":"base","value":"USD"},{"key":"symbols","value":"BRL"}]}}},{"name":"Erro - moeda invalida","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('retorna erro 4xx',()=>pm.expect(pm.response.code).to.be.within(400,499));"]}}],"request":{"method":"GET","url":{"raw":"{{baseUrl}}/latest?base=XXX&symbols=BRL","host":["{{baseUrl}}"],"path":["latest"],"query":[{"key":"base","value":"XXX"},{"key":"symbols","value":"BRL"}]}}},{"name":"Erro - data invalida","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('retorna erro 4xx',()=>pm.expect(pm.response.code).to.be.within(400,499));"]}}],"request":{"method":"GET","url":{"raw":"{{baseUrl}}/2026-99-99..2026-99-100?base=USD&symbols=BRL","host":["{{baseUrl}}"],"path":["2026-99-99..2026-99-100"],"query":[{"key":"base","value":"USD"},{"key":"symbols","value":"BRL"}]}}}]}
